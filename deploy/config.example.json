{
  "listen": ":8080",
  "plain_http": true,
  "trusted_proxies": ["127.0.0.1", "172.16.0.0/12"],
  "aliases": {
    "erp": "firebird-host:/firebird/data/erp.fdb"
  },
  "max_sessions": 500,
  "max_sessions_per_ip": 50,
  "max_body_bytes": 67108864,
  "max_fetch_rows": 5000,
  "max_inline_blob": 1048576,
  "idle_timeout_seconds": 1800,
  "shutdown_grace_seconds": 20
}
