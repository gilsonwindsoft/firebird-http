# Copy to .env (docker compose) or set in the Coolify UI.
# Firebird server ("host" or "host/port"). The client's Database (path or
# databases.conf alias) is opened on this server; the host it sends is ignored.
FBHTTP_FIREBIRD_HOST=10.0.0.5
# Optional:
# FBHTTP_ALIASES=erp=10.0.0.6:/firebird/data/erp.fdb;teste=10.0.0.6:erp_teste
# FBHTTP_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8
# FBHTTP_MAX_SESSIONS=500
# FBHTTP_MAX_SESSIONS_PER_IP=50
# FBHTTP_IDLE_TIMEOUT_SECONDS=600
# FBHTTP_SET_BIND=none
